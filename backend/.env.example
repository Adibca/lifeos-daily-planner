# ==============================================================
# LifeOS Daily Planner - Backend Environment Configuration
# ==============================================================

# Server Configuration
PROJECT_NAME="LifeOS Daily Planner"
API_V1_STR="/api/v1"
HOST="0.0.0.0"
PORT=8000
DEBUG=True

# SQLite Database
DATABASE_URL="sqlite+aiosqlite:///./lifeos.db"

# Telegram Bot API Configuration
# Get your token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_CHAT_ID="your_telegram_chat_id_here"
TELEGRAM_WEBHOOK_URL="https://yourdomain.com/api/v1/telegram/webhook"

# OpenAI API Configuration
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY="your_openai_api_key_here"
OPENAI_MODEL="gpt-4o"

# APScheduler Reminders Configuration
TIMEZONE="UTC"
REMINDER_CHECK_INTERVAL_SECONDS=60

